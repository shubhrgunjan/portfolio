# Public URL of the deployed site (used for SEO, RSS and link previews).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# /write editor login
ADMIN_PASSWORD=choose-a-long-password
AUTH_SECRET=any-random-string-of-32-plus-characters

# Publishing from the live site: the editor commits posts to this repo through
# the GitHub API, and Vercel redeploys on push.
# Create a fine-grained token with "Contents: Read and write" on this repo only.
GITHUB_TOKEN=
GITHUB_REPO=shubhrgunjan/portfolio
GITHUB_BRANCH=main
